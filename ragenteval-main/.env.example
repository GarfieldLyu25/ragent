# ragent 服务连接（初始化知识库、运行评测时使用）
RAGENT_BASE_URL=http://localhost:9090/api/ragent
RAGENT_USERNAME=admin
RAGENT_PASSWORD=admin

# 模型 API（填写自己的密钥；也可修改为兼容 OpenAI 的接口地址）
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
JUDGE_MODEL=gpt-5.4-mini
EMBEDDING_MODEL=text-embedding-3-large

# 快速上手示例的评分选项
RAGAS_ANSWER_RELEVANCY_STRICTNESS=1
RAGAS_SHOW_PROGRESS=1
